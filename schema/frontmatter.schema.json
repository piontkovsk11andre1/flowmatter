{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/piontkovsk11andre1/flowmatter/schema/frontmatter.schema.json",
  "title": "Flowmatter Markdown frontmatter",
  "description": "Frontmatter fields supported by one Flowmatter Markdown document.",
  "type": "object",
  "properties": {
    "flowmatter": {
      "const": "config",
      "description": "Contribute global relation types without creating a document node or HTML page."
    },
    "id": {
      "type": "string",
      "pattern": "\\S",
      "description": "Stable document ID. Defaults to the relative Markdown path without its extension."
    },
    "title": {
      "type": "string",
      "pattern": "\\S",
      "description": "Display title. Defaults to the first level-one heading, then the filename."
    },
    "module": {
      "description": "Parent flowjob module. A string is shorthand for a named module with a slug-derived ID.",
      "oneOf": [
        {
          "type": "string",
          "pattern": "\\S"
        },
        {
          "type": "object",
          "properties": {
            "id": { "type": "string", "pattern": "\\S" },
            "name": { "type": "string", "pattern": "\\S" },
            "viewUrl": { "type": "string", "description": "Local path to a selected Markdown overview, relative to this source file." },
            "type": { "type": "string", "pattern": "\\S" }
          },
          "additionalProperties": true
        }
      ]
    },
    "moduleTypes": {
      "description": "Map-wide module styles selected by module.type.",
      "oneOf": [
        { "type": "object", "propertyNames": { "$ref": "#/$defs/typeId" }, "additionalProperties": { "$ref": "#/$defs/moduleStyle", "unevaluatedProperties": false } },
        { "type": "array", "items": { "$ref": "#/$defs/moduleStyle", "properties": { "id": { "$ref": "#/$defs/typeId" } }, "required": ["id"], "unevaluatedProperties": false } }
      ]
    },
    "relationTypes": {
      "description": "Map-wide styles in a keyed mapping or an ordered list. Repeated IDs merge by property; conflicting values are errors.",
      "oneOf": [
        {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/typeId" },
          "additionalProperties": { "$ref": "#/$defs/style", "unevaluatedProperties": false }
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/style",
            "properties": { "id": { "$ref": "#/$defs/typeId" } },
            "required": ["id"],
            "unevaluatedProperties": false
          }
        }
      ]
    },
    "relations": {
      "type": "array",
      "description": "Directed relations from this document to documents selected by ID.",
      "items": {
        "type": "object",
        "required": ["to", "type"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "\\S",
            "description": "Stable relation ID. Defaults to <document-id>:<one-based-index>."
          },
          "to": {
            "type": "string",
            "pattern": "\\S",
            "description": "Target document ID."
          },
          "type": {
            "type": "string",
            "pattern": "\\S",
            "description": "Flow label."
          },
          "relationType": {
            "type": "string",
            "pattern": "\\S",
            "description": "Optional flowjob relation styling/filter key."
          },
          "viewUrl": {
            "type": "string",
            "pattern": "^(?!/)[^\\\\:\\u0000-\\u001f]*\\.(?:[mM][dD]|html)$",
            "description": "Local path relative to this Markdown file. Select an included .md file or its generated .html path; write literal filenames, not URL-encoded segments. A referenced file without Flowmatter document fields renders only as a page."
          }
        },
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "typeId": { "type": "string", "pattern": "^\\S(?:[\\s\\S]*\\S)?$" },
    "moduleStyle": {
      "type": "object",
      "properties": {
        "label": {"type":"string","pattern":"\\S"},
        "accent": {"$ref":"#/$defs/hexColor"}, "surface": {"$ref":"#/$defs/hexColor"},
        "headerBg": {"$ref":"#/$defs/hexColor"}, "headerFg": {"$ref":"#/$defs/hexColor"}, "footerFg": {"$ref":"#/$defs/hexColor"}
      }
    },
    "style": {
      "type": "object",
      "properties": {
        "label": { "type": "string", "pattern": "\\S" },
        "hint": { "type": "string", "pattern": "\\S", "description": "Short description shown under the connection filter label." },
        "color": { "$ref": "#/$defs/hexColor" },
        "previewColor": { "$ref": "#/$defs/hexColor" }
      }
    },
    "hexColor": {
      "type": "string",
      "description": "CSS hex color; quote it in YAML so # does not start a comment.",
      "pattern": "^#(?:[0-9A-Fa-f]{3,4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$"
    }
  },
  "additionalProperties": true
}
